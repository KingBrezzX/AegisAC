<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ============================== -->
    <!-- AegisAC                        -->
    <!-- Anti-Cheat by KingBrezz        -->
    <!-- ============================== -->

    <groupId>id.kingbrezz</groupId>
    <artifactId>AegisAC</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>AegisAC</name>
    <description>Modern lightweight Minecraft Java anti-cheat.</description>
    <url>https://github.com/KingBrezz/AegisAC</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java 25 -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <!-- ============================== -->
    <!-- Repositories                   -->
    <!-- ============================== -->

    <repositories>

        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

    </repositories>

    <!-- ============================== -->
    <!-- Dependencies                   -->
    <!-- ============================== -->

    <dependencies>

        <!-- Paper API 26.2 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <!-- ============================== -->
    <!-- Build                          -->
    <!-- ============================== -->

    <build>

        <finalName>AegisAC</finalName>

        <plugins>

            <!-- Java Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>

                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>

                <configuration>
                    <archive>

                        <manifest>
                            <addDefaultImplementationEntries>
                                true
                            </addDefaultImplementationEntries>
                        </manifest>

                        <manifestEntries>
                            <Implementation-Title>
                                AegisAC
                            </Implementation-Title>

                            <Implementation-Version>
                                ${project.version}
                            </Implementation-Version>

                            <Implementation-Vendor>
                                KingBrezz
                            </Implementation-Vendor>
                        </manifestEntries>

                    </archive>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>
